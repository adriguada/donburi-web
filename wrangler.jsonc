/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "donburi-web",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-17",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// The Worker runs before static assets for the API and the admin panel,
		// so it can verify the Cloudflare Access token before serving them.
		"run_worker_first": ["/api/*", "/admin", "/admin/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "donburi-db",
			// Placeholder: replace with the id printed by `wrangler d1 create donburi-db`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Cloudflare Access team domain, e.g. "myteam.cloudflareaccess.com".
		"ACCESS_TEAM_DOMAIN": "",
		// Application Audience (AUD) tag of the Access application protecting /admin and the write API.
		"ACCESS_AUD": ""
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
